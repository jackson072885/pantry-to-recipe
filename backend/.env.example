# Pantry-to-Recipe backend local config example.
# Copy to backend/.env for local-only use. Never commit real provider keys.

# Safe default: keep live external recipe search disabled.
EXTERNAL_RECIPE_PROVIDER=disabled

# Manual Spoonacular smoke testing only:
# set EXTERNAL_RECIPE_PROVIDER=spoonacular and provide this key in backend/.env
# or in a PowerShell session. Do not use live provider keys in automated tests.
SPOONACULAR_API_KEY=

# Reserved for future/manual Edamam provider testing.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
